# Your private ntfy topic: pick something long and random, then subscribe to it in the ntfy app
NTFY_TOPIC=
# Only change these if you self-host ntfy or use a protected topic
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Seconds between checks (min 30)
INTERVAL=60
# Optional: check faster during this local time window, e.g. 07:00-09:30
FAST_WINDOW=
FAST_INTERVAL=20
# 1 = beep on this computer when slots appear
BEEP=1
